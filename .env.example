# ─────────────────────────────────────────────────────────────
# Supabase — powers the contact form + visitor counter.
# Copy this file to `.env` and fill in the two values from your
# Supabase project: Settings → API.
#
# The site works WITHOUT these (contact form falls back to a
# mailto link, counter hides), so you can develop before setup.
#
# These are PUBLIC values (safe for the browser). Never put the
# service_role / secret key here — it must never reach the client.
# ─────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
